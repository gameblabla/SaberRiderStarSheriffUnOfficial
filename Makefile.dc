# Dreamcast build (KallistiOS):
#   source /opt/toolchains/dc/kos/environ.sh
#   make -f Makefile.dc            -> saber_rider.elf
#   make -f Makefile.dc disc       -> build/dc/saber_rider.cdi (runs tools/dc/build_disc.py; needs the demo's data)
#   make -f Makefile.dc rebake     -> the same, reusing the converted music and videos (textures, sounds, files baked again)
#   make -f Makefile.dc repack     -> only the new ELF
# The core game (src/*.c) + the Dreamcast platform (src/platform/dreamcast) + the vendored ZAMV5 video codec
# (third_party/zamv, from KOS's zamv5-sh4zam-r8 example: SH4ZAM-accelerated decode straight into the PVR's
# hardware YUV converter - see video_dcmv.c). Audio for videos is still AICA ADPCM through aud_dc.c, same as sfx.
# dcfmv/ itself (the old DCMV video decoder) is gone, but pack.c still leans on its LZ40 SH-4 decompressor
# (lz40.h/lz40_dec.S, VincentNLOBJ/CUE) for every baked pack, video or not, so that piece of the old dir stays.
TARGET  := saber_rider.elf
OBJDIR  := obj-dc
ZAMV_SRC := third_party/zamv/bitstream.c third_party/zamv/codec.c third_party/zamv/common.c \
            third_party/zamv/input.c third_party/zamv/transform.c third_party/zamv/zamv_dc_helpers.c \
            third_party/zamv/zamv_sh4.c
SRC     := $(wildcard src/*.c) $(wildcard src/platform/dreamcast/*.c) $(ZAMV_SRC)
OBJ     := $(patsubst src/%.c,$(OBJDIR)/%.o,$(filter src/%,$(SRC))) \
           $(patsubst third_party/zamv/%.c,$(OBJDIR)/zamv/%.o,$(filter third_party/zamv/%,$(SRC)))
ASMSRC  := src/platform/dreamcast/dcfmv/lz40_dec.S
OBJ     += $(ASMSRC:src/%.S=$(OBJDIR)/%.o)
# PLAT_BAKED_ASSETS: textures, samples and our other files come baked into tex.pck / snd.pck / files.pck (build_disc.py)
DEFS    := -DPLAT_DREAMCAST -DPLAT_LOW_MEMORY -DPLAT_BAKED_ASSETS -DZAMV_USE_SH4ZAM
# 640x480/832x480 + stretch/wide screen modes (see plat_dc.c screen_mode). Used to stay behind this define because
# 640x480/832x480 dropped to 30 fps on real hardware: newer GCC's loop unrolling collides with its LRA register
# allocator in tight per-vertex transform loops (the same regression sh4zam's own "Bruce's Balls" example hit,
# https://github.com/gyrovorbis/sh4zam/issues/69 - fixed there by turning unrolling off for that loop). -fno-unroll-loops
# below is the same fix applied to the whole translation unit, so the hires modes are safe to ship now.
DEFS    += -DDC_HIRES_MODES
# KOS, kos-ports and the game must all use one SH4 float ABI: environ.sh sets
# KOS_SH4_PRECISION=-m4-single-only (32-bit double). Mixing it with -m4-single links the wrong
# newlib multilib and libm/printf return garbage (floorf(96) == 0).
ifneq ($(KOS_SH4_PRECISION),-m4-single-only)
$(error KOS_SH4_PRECISION is '$(KOS_SH4_PRECISION)'; set it to -m4-single-only in environ.sh and rebuild KOS + kos-ports)
endif
# KOS_CFLAGS brings -O3 -ffast-math; the game keeps IEEE infinities out of fast-math's way. -fno-unroll-loops: see the
# DC_HIRES_MODES comment above - sh4zam issue #69's GCC/LRA regression, worked around the same way upstream did.
CFLAGS  := -std=gnu11 -Isrc -Ithird_party/zamv $(DEFS) -MMD -MP -fno-finite-math-only -fno-unroll-loops -Wno-unused-parameter -Wno-misleading-indentation -Wno-format
# ZAMV5's whole contract is bit-exact agreement with its scalar IEEE round-to-nearest/even oracle; KOS_CFLAGS'
# -ffast-math/-ffp-contract=fast would break that, so turn them back off (after KOS_CFLAGS is already on the
# command line, hence the plain += above, not a reorder) for the vendored codec's own translation units only.
$(OBJDIR)/zamv/%.o: CFLAGS += -fno-fast-math -ffp-contract=off -fno-strict-aliasing -Wno-unused-function
LIBS    := -lADX -lsh4zam -lm -Wl,--wrap=snd_stream_shutdown -Wl,--wrap=snd_stream_start -Wl,--wrap=snd_stream_poll   # see aud_dc.c
DATA    ?= SaberRider/data

.PHONY: all clean disc rebake repack
all: $(TARGET)

$(TARGET): $(OBJ)
	kos-cc -o $@ $(OBJ) $(LIBS)

$(OBJDIR)/%.o: src/%.c
	@mkdir -p $(dir $@)
	kos-cc $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: src/%.S
	@mkdir -p $(dir $@)
	kos-cc $(CFLAGS) -c $< -o $@

$(OBJDIR)/zamv/%.o: third_party/zamv/%.c
	@mkdir -p $(dir $@)
	kos-cc $(CFLAGS) -c $< -o $@

-include $(OBJ:.o=.d)

disc: $(TARGET)
	python3 tools/dc/build_disc.py --elf $(TARGET) --data $(DATA) --out build/dc

rebake: $(TARGET)
	python3 tools/dc/build_disc.py --elf $(TARGET) --data $(DATA) --out build/dc --rebake

repack: $(TARGET)
	python3 tools/dc/build_disc.py --elf $(TARGET) --out build/dc --repack

clean:
	rm -rf $(OBJDIR) $(TARGET)
