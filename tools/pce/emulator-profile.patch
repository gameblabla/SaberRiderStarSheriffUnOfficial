 {
+uint64 *PCE_CycleProf = nullptr;	// physical-address master-clock cycle counts (profiling extension)
@@ NO_INLINE void HuC6280::RunSub(void)
  do
  {
+         if(MDFN_UNLIKELY(PCE_CycleProf))
+         {
+          static uint32 prof_pc = 0, prof_ts = 0;
+          uint32 d = timestamp - prof_ts;
+          if(d < 2000000) PCE_CycleProf[prof_pc] += d;
+          prof_ts = timestamp;
+          prof_pc = (((uint32)MPR[(PC >> 13) & 7]) << 13) | (PC & 0x1FFF);
+         }
          if(DebugMode)
           old_PC = PC;
