# The compiler, includes, libraries and pce-mkcd come from the same SDK root.
MOS ?= ../PCE/llvm-mos8
PCE_CC := $(MOS)/bin/mos-pce-cd-clang
SGX ?= 0
OUT ?= $(if $(filter 1,$(SGX)),build/sgx,build/pce)
PCE_FLAGS := -std=gnu11 -Os -Wall -Wextra -Werror -Isrc/platform/pce -I$(OUT) -flto -mlto-zp=$(if $(filter 1,$(SGX)),96,0)
DEBUG ?= 0
ifeq ($(DEBUG),1)
PCE_FLAGS += -DDEBUG=1
endif
LEVEL_SELECT ?= $(DEBUG)
ifeq ($(LEVEL_SELECT),1)
PCE_FLAGS += -DLEVEL_SELECT=1
endif
RETAIL ?= 1
ifeq ($(RETAIL),1)
PCE_FLAGS += -DRETAIL
endif
ifeq ($(SGX),1)
PCE_FLAGS += -DPCE_SGX
PCE_ASSET_FLAGS := --sgx
PCE_MATH_LINK := $(foreach helper,mulqi3 mulhi3 mulsi3 udivqi3 udivhi3 udivsi3 umodqi3 umodhi3 divhi3,-Wl,--wrap=__$(helper))
endif
PCE_SRC := $(wildcard src/platform/pce/*.c)
PCE_SRC := $(filter-out src/platform/pce/ipl.c,$(PCE_SRC))
PCE_SRC += $(wildcard src/platform/pce/*.S)
PCE_SRC += $(wildcard src/platform/pce/m6/*.c) $(wildcard src/platform/pce/m6/*.S)
PCE_SRC += $(OUT)/assets.c
PCE_ASSETS := $(OUT)/assets.h $(OUT)/assets.c $(OUT)/m6.h $(OUT)/manifest.json $(OUT)/source.sha256
PCE_ASSETS += $(foreach stage,1 2 3 4 5 6 7,$(OUT)/s$(stage).bin) $(OUT)/font.bin $(OUT)/ui.bin $(OUT)/victory.bin
PCE_AUDIO := $(OUT)/audio.json $(OUT)/music.h $(foreach track,00 01 02 03 04 05 06 07 08 09 10 11 12 13 14 15 16 17,$(OUT)/music$(track).bin)
PCE_AUDIO += $(OUT)/samples.h $(OUT)/pcm.h $(OUT)/psg.h $(foreach hero,0 1 2 3,$(OUT)/voice$(hero).bin)

.PHONY: all assets test test-sgx test-campaign test-presentation test-audio test-herd test-dialog test-wip FORCE
all: $(OUT)/saber_rider.cue

$(OUT):
	mkdir -p $@

# Switching RETAIL, DEBUG or SGX must relink even when the source timestamps are unchanged.
$(OUT)/build-flags: FORCE | $(OUT)
	@printf '%s\n' '$(PCE_FLAGS)' | cmp -s - $@ || printf '%s\n' '$(PCE_FLAGS)' > $@

$(OUT)/ipl.bin: tools/pce/ipl.py ../PCE/huc/src/isolink/main.c | $(OUT)
	python3 $< ../PCE/huc/src/isolink/main.c $@

$(OUT)/ipl_font.h: tools/pce/ipl_font.py | $(OUT)
	python3 $< $@

$(PCE_AUDIO) &: tools/pce/build_audio.py tools/pce/adpcm.py tools/pce/adpcm2.py ../PCE/Sound/adpcm_build_14_2bit.pce src/audio.c $(wildcard SaberRider/data/*.pck assets/voice/*.wav assets/sfx/*.wav) assets/power/saber_intermission.wav | $(OUT)
	python3 $< --out $(OUT)

$(OUT)/ipl.elf: src/platform/pce/ipl.c src/platform/pce/link/ipl.ld $(OUT)/ipl_font.h | $(OUT)
	$(PCE_CC) $(PCE_FLAGS) $< -o $@ -T src/platform/pce/link/ipl.ld -Wl,-Map,$@.map
	$(MOS)/bin/llvm-objcopy --remove-section=.llvm_sympart --remove-section=.rela.llvm_sympart $@

assets: | $(OUT)
	python3 tools/pce/build_assets.py --out $(OUT) $(PCE_ASSET_FLAGS)

$(PCE_ASSETS) &: tools/pce/build_assets.py tools/pce/road_curves.py tools/pce/formats.py tools/pce/palfit.py tools/pce/tile_budget.py tools/pce/export.c tools/pce/export_muzzle.c tools/pce/export_track.c tools/pce/story.py tools/pce/timeline.py tools/pce/presentation.py tools/pce/frontend.py $(wildcard src/*.[ch]) $(wildcard SaberRider/data/*.pck) $(wildcard assets/*.png assets/*.txt assets/pce/*.png assets/victory/*.png assets/ramrod/*.png assets/ramrod/*.txt assets/space/*.png assets/space/*.txt assets/stage3/native/*.png) $(OUT)/build-flags | $(OUT)
	python3 tools/pce/build_assets.py --out $(OUT) $(PCE_ASSET_FLAGS)

$(OUT)/app_full.elf: $(PCE_SRC) $(wildcard src/platform/pce/*.h) $(wildcard src/platform/pce/m6/*.h) $(OUT)/assets.h $(OUT)/m6.h $(OUT)/samples.h $(OUT)/pcm.h $(OUT)/psg.h $(OUT)/music.h $(OUT)/build-flags Makefile.pce tools/pce/check_elf.py src/platform/pce/link/link.ld
	$(PCE_CC) $(PCE_FLAGS) $(PCE_SRC) -I src/platform/pce/m6 -o $@ -T src/platform/pce/link/link.ld -Wl,-Map,$(OUT)/app.elf.map $(PCE_MATH_LINK)
	python3 tools/pce/check_elf.py $(MOS)/bin/llvm-nm $@
	$(MOS)/bin/llvm-objcopy --remove-section=.llvm_sympart --remove-section=.rela.llvm_sympart $@

$(OUT)/app.elf $(OUT)/m6.bin &: $(OUT)/app_full.elf tools/pce/m6_image.py
	python3 tools/pce/m6_image.py --mos $(MOS) --out $(OUT)

# Ramrod's arena (stage 6): src/platform/pce/m6/ is linked with the application into virtual banks 144, 145, 146 and 131 (link.ld), four 8 KiB code images that
# m6_image.py cuts out of the link (m6.bin, and app.elf is the link without them); build_disc.py puts them into the stage 6 archive and m6_load reads
# them into code banks $76, $77, $79 and $7a.
$(OUT)/saber_rider.cue: $(OUT)/ipl.bin $(OUT)/ipl.elf $(OUT)/app.elf $(OUT)/m6.bin $(PCE_ASSETS) $(PCE_AUDIO) tools/pce/build_disc.py tools/pce/zx02_archive.py
	python3 tools/pce/build_disc.py --mos $(MOS) --out $(OUT)

test: all
	python3 tools/pce/test_port.py --out $(OUT)
	python3 tools/pce/test_campaign.py --out $(OUT)
	python3 tools/pce/test_wip.py --out $(OUT)
	python3 tools/pce/test_boss_presentation.py --out $(OUT)
	python3 tools/pce/test_boss_passes.py --out $(OUT)
	python3 tools/pce/test_priority.py --out $(OUT)
	python3 tools/pce/test_herd.py --out $(OUT)
	python3 tools/pce/test_herd_render.py --out $(OUT)
	python3 tools/pce/test_herd_visibility.py --out $(OUT)
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 1 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 2 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 3 --require-60
	python3 tools/pce/test_foreground.py --out $(OUT)
	python3 tools/pce/test_presentation.py --out $(OUT)
	python3 tools/pce/test_dialog_restore.py --out $(OUT)
	python3 tools/pce/test_graphics_stability.py --out $(OUT)
	python3 tools/pce/test_audio.py --out $(OUT)
	python3 tools/pce/test_adpcm2.py --out $(OUT)
	python3 tools/pce/test_software_adpcm.py --out $(OUT)

test-campaign: all
	python3 tools/pce/test_campaign.py --out $(OUT)
	python3 tools/pce/test_priority.py --out $(OUT)
	python3 tools/pce/test_boss_presentation.py --out $(OUT)
	python3 tools/pce/test_boss_passes.py --out $(OUT)
	python3 tools/pce/test_herd.py --out $(OUT)

# Exercise the actual retail SGX campaign with hardware sprite limits enabled.
# The generic presentation fixtures below drive a non-retail debug stage menu.
test-sgx:
	$(MAKE) -f Makefile.pce SGX=1 OUT=build/sgx all
	python3 tools/pce/test_sgx_fast_math.py --out build/sgx
	python3 tools/pce/test_campaign.py --out build/sgx --sgx
	python3 tools/pce/test_sgx_frontend.py --out build/sgx
	python3 tools/pce/test_sgx_motion.py --out build/sgx
	python3 tools/pce/test_sgx_rendering.py --out build/sgx
	python3 tools/pce/test_sgx_house.py --out build/sgx
	python3 tools/pce/test_sgx_house_moon.py --out build/sgx
	python3 tools/pce/test_sgx_moon_restore.py --out build/sgx
	python3 tools/pce/test_cdda_leadout.py --out build/sgx --sgx
	python3 tools/pce/test_sgx_regressions.py --out build/sgx
	python3 tools/pce/test_sgx_reported_issues.py --out build/sgx
	python3 tools/pce/test_sgx_race.py --out build/sgx
	python3 tools/pce/test_sgx_cache_pressure.py --out build/sgx
	python3 tools/pce/test_sgx_depth.py --out build/sgx
	python3 tools/pce/test_sgx_combat_profile.py --out build/sgx
	python3 tools/pce/test_herd.py --out build/sgx --sgx
	python3 tools/pce/test_sgx_herd_exit.py --out build/sgx
	python3 tools/pce/test_race_math.py --out build/sgx --sgx
	python3 tools/pce/test_road_curves.py --out build/sgx
	python3 tools/pce/test_road.py --out build/sgx --sgx --tag road-speed --require-fps 25
	python3 tools/pce/test_sgx_late_stages.py --out build/sgx
	python3 tools/pce/test_sgx_last2.py --out build/sgx
	python3 tools/pce/test_sgx_last3.py --out build/sgx
	python3 tools/pce/test_sgx_arena_sprites.py --out build/sgx
	python3 tools/pce/test_sgx_space_planet.py --out build/sgx
	python3 tools/pce/test_sgx_final_boss.py --out build/sgx

test-presentation: all
	python3 tools/pce/test_presentation.py --out $(OUT)
	python3 tools/pce/test_dialog_restore.py --out $(OUT)
	python3 tools/pce/test_foreground.py --out $(OUT)

test-audio: all
	python3 tools/pce/test_audio.py --out $(OUT)
	python3 tools/pce/test_adpcm2.py --out $(OUT)
	python3 tools/pce/test_software_adpcm.py --out $(OUT)

test-herd: all
	python3 tools/pce/test_herd.py --out $(OUT)
	python3 tools/pce/test_herd_render.py --out $(OUT)
	python3 tools/pce/test_herd_visibility.py --out $(OUT)
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 1 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 2 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 3 --require-60

test-dialog: all
	python3 tools/pce/test_dialog_restore.py --out $(OUT)

# Needs a debug (RETAIL=0) build: it drives the debug stage menu.
test-dialog-palette:
	python3 tools/pce/test_dialog_palette.py --out $(OUT)

test-wip: all
	python3 tools/pce/test_wip.py --out $(OUT)
