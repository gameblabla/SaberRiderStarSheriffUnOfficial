# The compiler, includes, libraries and pce-mkcd come from the same SDK root.
MOS ?= ../PCE/llvm-mos8
PCE_CC := $(MOS)/bin/mos-pce-cd-clang
OUT ?= build/pce
PCE_FLAGS := -std=gnu11 -Os -Wall -Wextra -Werror -Isrc/platform/pce -I$(OUT) -flto -mlto-zp=0
PCE_SRC := $(wildcard src/platform/pce/*.c)
PCE_SRC := $(filter-out src/platform/pce/ipl.c,$(PCE_SRC))
PCE_SRC += $(wildcard src/platform/pce/*.S)
PCE_SRC += $(OUT)/assets.c
PCE_ASSETS := $(OUT)/assets.h $(OUT)/assets.c $(OUT)/manifest.json $(OUT)/source.sha256
PCE_ASSETS += $(foreach stage,1 2 3 4 5 6 7,$(OUT)/s$(stage).bin) $(OUT)/font.bin $(OUT)/ui.bin
PCE_AUDIO := $(OUT)/audio.json $(foreach track,00 01 02 03 04 05 06 07 08 09 10 11 12 13 14 15 16 17,$(OUT)/music$(track).bin $(OUT)/music$(track)_m.bin $(OUT)/music$(track)_l.bin) $(OUT)/music_end.bin $(OUT)/music_end_m.bin $(OUT)/music_end_l.bin
PCE_AUDIO += $(OUT)/samples.h $(OUT)/pcm.h $(foreach hero,0 1 2 3,$(OUT)/voice$(hero).bin)

.PHONY: all assets test test-campaign test-presentation test-audio test-herd
all: $(OUT)/saber_rider.cue

$(OUT):
	mkdir -p $@

$(OUT)/ipl.bin: tools/pce/ipl.py ../PCE/huc/src/isolink/main.c | $(OUT)
	python3 $< ../PCE/huc/src/isolink/main.c $@

$(OUT)/ipl_font.h: tools/pce/ipl_font.py | $(OUT)
	python3 $< $@

$(PCE_AUDIO) &: tools/pce/build_audio.py tools/pce/adpcm.py tools/pce/adpcm2.py ../PCE/Sound/adpcm_build_14_2bit.pce src/audio.c $(wildcard SaberRider/data/*.pck assets/voice/*.wav) | $(OUT)
	python3 $< --out $(OUT)

$(OUT)/ipl.elf: src/platform/pce/ipl.c src/platform/pce/link/ipl.ld $(OUT)/ipl_font.h | $(OUT)
	$(PCE_CC) $(PCE_FLAGS) $< -o $@ -T src/platform/pce/link/ipl.ld -Wl,-Map,$@.map
	$(MOS)/bin/llvm-objcopy --remove-section=.llvm_sympart --remove-section=.rela.llvm_sympart $@

assets: | $(OUT)
	python3 tools/pce/build_assets.py --out $(OUT)

$(PCE_ASSETS) &: tools/pce/build_assets.py tools/pce/formats.py tools/pce/export.c tools/pce/export_muzzle.c tools/pce/export_track.c tools/pce/story.py tools/pce/timeline.py tools/pce/presentation.py tools/pce/frontend.py $(wildcard src/*.[ch]) $(wildcard SaberRider/data/*.pck) $(wildcard assets/*.png assets/*.txt assets/ramrod/*.png assets/ramrod/*.txt assets/space/*.png assets/space/*.txt assets/stage3/native/*.png) | $(OUT)
	python3 tools/pce/build_assets.py --out $(OUT)

$(OUT)/app.elf: $(PCE_SRC) $(wildcard src/platform/pce/*.h) $(OUT)/assets.h $(OUT)/samples.h $(OUT)/pcm.h Makefile.pce tools/pce/check_elf.py src/platform/pce/link/link.ld
	$(PCE_CC) $(PCE_FLAGS) $(PCE_SRC) -o $@ -T src/platform/pce/link/link.ld -Wl,-Map,$@.map
	python3 tools/pce/check_elf.py $(MOS)/bin/llvm-nm $@
	$(MOS)/bin/llvm-objcopy --remove-section=.llvm_sympart --remove-section=.rela.llvm_sympart $@

$(OUT)/saber_rider.cue: $(OUT)/ipl.bin $(OUT)/ipl.elf $(OUT)/app.elf $(PCE_ASSETS) $(PCE_AUDIO) tools/pce/build_disc.py
	python3 tools/pce/build_disc.py --mos $(MOS) --out $(OUT)

test: all
	python3 tools/pce/test_port.py --out $(OUT)
	python3 tools/pce/test_campaign.py --out $(OUT)
	python3 tools/pce/test_herd.py --out $(OUT)
	python3 tools/pce/test_herd_render.py --out $(OUT)
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 1 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 2 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 3 --require-60
	python3 tools/pce/test_foreground.py --out $(OUT)
	python3 tools/pce/test_presentation.py --out $(OUT)
	python3 tools/pce/test_audio.py --out $(OUT)
	python3 tools/pce/test_adpcm2.py --out $(OUT)
	python3 tools/pce/test_software_adpcm.py --out $(OUT)

test-campaign: all
	python3 tools/pce/test_campaign.py --out $(OUT)
	python3 tools/pce/test_herd.py --out $(OUT)

test-presentation: all
	python3 tools/pce/test_presentation.py --out $(OUT)
	python3 tools/pce/test_foreground.py --out $(OUT)

test-audio: all
	python3 tools/pce/test_audio.py --out $(OUT)
	python3 tools/pce/test_adpcm2.py --out $(OUT)
	python3 tools/pce/test_software_adpcm.py --out $(OUT)

test-herd: all
	python3 tools/pce/test_herd.py --out $(OUT)
	python3 tools/pce/test_herd_render.py --out $(OUT)
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 1 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 2 --require-60
	python3 tools/pce/profile_gameplay.py --out $(OUT) --herd 3 --require-60
