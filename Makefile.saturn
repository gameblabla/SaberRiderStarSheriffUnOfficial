# Sega Saturn build (libyaul; a stock console, no RAM cartridge). See plan.md.
#   source ~/.yaul.env
#   make -f Makefile.saturn             -> build/saturn/saber_rider.iso + .cue from the staged disc tree
#   make -f Makefile.saturn disc        -> bake the disc tree first (tools/saturn/build_disc.py; needs the demo's data)
#   make -f Makefile.saturn RENDER=null -> no graphics (platform/null/render_null.c): the bring-up / CPU-profile build
# The core game (src/*.c) + the Saturn platform (src/platform/saturn), linked by libyaul's build rules.
ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
  $(error Undefined YAUL_INSTALL_ROOT: source ~/.yaul.env first)
endif

include $(YAUL_INSTALL_ROOT)/share/build.pre.mk

RENDER  ?= vdp
DATA    ?= SaberRider/data
OUT     := build/saturn

SH_PROGRAM    := saber_rider
SH_BUILD_DIR  := obj-saturn
SH_OUTPUT_DIR := $(OUT)
SH_SRCS := $(wildcard src/*.c) $(filter-out %/render_sat.c %/vdp2_planes.c %/video_sat.c,$(wildcard src/platform/saturn/*.c))
ifeq ($(RENDER),null)
SH_SRCS   += src/platform/null/render_null.c src/platform/null/video_null.c
SH_CFLAGS += -DSAT_RENDER_NULL
else
CPK_DIR := third_party/libyaul_cinepak
SH_SRCS += src/platform/saturn/render_sat.c src/platform/saturn/vdp2_planes.c src/platform/saturn/video_sat.c \
	$(addprefix $(CPK_DIR)/,base.c film_buff.c film_cvid.c film_lib.c film_snd.c pcmsys.c snd_adx.c)
SH_CFLAGS += -I$(CPK_DIR)
endif

# REAL_FIXED, FX_NO_FLOAT: the core in 16.16 fixed point (src/real.h), no float anywhere - the SH-2 has no FPU, and the
# link is checked for soft-float routines (the .nofloat step below)
# PLAT_BAKED_ASSETS: textures, samples and our other files come baked into tex.pck / snd.pck / files.pck (build_disc.py);
# PLAT_STAGE_PACK: stage.pck, opened first (a level without the tile maps its VDP2 planes draw: tools/saturn/layers.py)
SH_CFLAGS += -std=gnu11 -O2 -g -Isrc/platform/saturn/include -Isrc \
	-DPLAT_SATURN -DPLAT_LOW_MEMORY -DPLAT_BAKED_ASSETS -DPLAT_STAGE_PACK \
	-DREAL_FIXED -DFX_NO_FLOAT -Wdouble-promotion -Wfloat-conversion \
	-Wno-shadow -Wno-bad-function-cast -Wno-null-dereference -Wno-unused-parameter -Wno-sign-compare \
	-Wno-missing-field-initializers -Wno-implicit-fallthrough -Wno-misleading-indentation -Wno-unused-function
SH_LDFLAGS +=

IMAGE_DIRECTORY        := $(OUT)/stage
AUDIO_TRACKS_DIRECTORY := $(OUT)/tracks
IMAGE_1ST_READ_BIN     := 0.BIN

IP_VERSION           := V0.100
IP_RELEASE_DATE      := 20260924
IP_AREAS             := JTUBKAEL
IP_PERIPHERALS       := JAMKST
IP_TITLE             := SABER RIDER
IP_MASTER_STACK_ADDR := 0x06004000
IP_SLAVE_STACK_ADDR  := 0x06001E00
IP_1ST_READ_ADDR     := 0x06004000
IP_1ST_READ_SIZE     := 0

include $(YAUL_INSTALL_ROOT)/share/build.post.iso-cue.mk

# no soft-float in the program: libgcc's float / double routines (__addsf3, __muldf3, __fixsfsi, __floatsisf, __ltsf2,
# __extendsfdf2...) in the linked symbols fail the build, with the objects that call them
$(SH_BUILD_PATH)/$(SH_PROGRAM).bin: $(SH_BUILD_PATH)/$(SH_PROGRAM).nofloat
$(SH_BUILD_PATH)/$(SH_PROGRAM).nofloat: $(SH_BUILD_PATH)/$(SH_PROGRAM).elf
	@SF='_*__[a-z]+(sf|df)[23]$$|_*__fix(uns)?(sf|df)(si|di)$$|_*__float(un)?(si|di)(sf|df)$$'; \
	if $(SH_NM) $< | grep -Eq " ($$SF)"; then \
		echo "soft-float linked in:"; $(SH_NM) $< | grep -E " ($$SF)"; \
		for o in $(SH_OBJS_UNIQ); do $(SH_NM) -u $$o | grep -Eq "($$SF)" && echo "  called from $$o"; done; \
		exit 1; \
	fi; touch $@

# the image also follows the staged files (build_disc.py), not only the program
$(SH_OUTPUT_PATH)/$(SH_PROGRAM).iso: $(filter-out %/0.BIN,$(wildcard $(IMAGE_DIRECTORY)/*))

.PHONY: disc
disc:
	python3 tools/saturn/build_disc.py --data $(DATA) --out $(OUT)
	$(MAKE) -f Makefile.saturn RENDER=$(RENDER)
