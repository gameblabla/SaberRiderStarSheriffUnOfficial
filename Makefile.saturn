# Sega Saturn build (libyaul; a stock console, no RAM cartridge). See plan.md.
#   source ~/.yaul.env
#   make -f Makefile.saturn             -> build/saturn/saber_rider.iso from the staged disc tree, then
#                                          tools/saturn/make_bincue.py turns the .iso + tracks/*.BIN into one
#                                          saber_rider.bin + a single-FILE saber_rider.cue (a real disc's layout)
#   make -f Makefile.saturn disc        -> bake the disc tree first (tools/saturn/build_disc.py; needs the demo's data)
#   make -f Makefile.saturn RENDER=null -> no graphics (platform/null/render_null.c): the bring-up / CPU-profile build
# The core game (src/*.c) + the Saturn platform (src/platform/saturn), linked by libyaul's build rules.
ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
  $(error Undefined YAUL_INSTALL_ROOT: source ~/.yaul.env first)
endif

include $(YAUL_INSTALL_ROOT)/share/build.pre.mk

RENDER  ?= vdp
DATA    ?= SaberRider/data
OUT     := build/saturn
OBJ     := obj-saturn
# DIAG=1: the diagnostic disc for a console (src/platform/saturn/diag_sat.c: the log on screen at boot and when the
# game stalls), built apart in build/saturn-diag from build/saturn's staged files and CD-DA tracks (make disc first)
DIAG    ?= 0
ifeq ($(DIAG),1)
OUT     := build/saturn-diag
OBJ     := obj-saturn-diag
SH_CFLAGS += -DSAT_DIAG
endif

SH_PROGRAM    := saber_rider
SH_BUILD_DIR  := $(OBJ)
SH_OUTPUT_DIR := $(OUT)
SH_SRCS := $(wildcard src/*.c) $(filter-out %/render_sat.c %/vdp2_planes.c %/video_sat.c,$(wildcard src/platform/saturn/*.c))
SH_SRCS += src/platform/saturn/lz40s.sx   # the LZ40S decoder (SH-2 assembly)
ifeq ($(RENDER),null)
SH_SRCS   += src/platform/null/render_null.c src/platform/null/video_null.c
SH_CFLAGS += -DSAT_RENDER_NULL
else
CPK_DIR := third_party/libyaul_cinepak
SH_SRCS += src/platform/saturn/render_sat.c src/platform/saturn/vdp2_planes.c src/platform/saturn/video_sat.c \
	$(addprefix $(CPK_DIR)/,base.c film_buff.c film_cvid.c film_lib.c film_snd.c pcmsys.c snd_adx.c)
SH_CFLAGS += -I$(CPK_DIR)
endif

# REAL_FIXED, FX_NO_FLOAT: the core in 16.16 fixed point (src/real.h), no float anywhere - the SH-2 has no FPU, and the
# link is checked for soft-float routines (the .nofloat step below)
# PLAT_BAKED_ASSETS: textures, samples and our other files come baked into tex.pck / snd.pck / files.pck (build_disc.py);
# PLAT_STAGE_PACK: stage.pck, opened first (a level without the tile maps its VDP2 planes draw: tools/saturn/layers.py)
SH_CFLAGS += -std=gnu11 -O2 -g -Isrc/platform/saturn/include -Isrc \
	-DPLAT_SATURN -DPLAT_LOW_MEMORY -DPLAT_BAKED_ASSETS -DPLAT_STAGE_PACK \
	-DREAL_FIXED -DFX_NO_FLOAT -Wdouble-promotion -Wfloat-conversion \
	-Wno-shadow -Wno-bad-function-cast -Wno-null-dereference -Wno-unused-parameter -Wno-sign-compare \
	-Wno-missing-field-initializers -Wno-implicit-fallthrough -Wno-misleading-indentation -Wno-unused-function
SH_LDFLAGS +=

IMAGE_DIRECTORY        := $(OUT)/stage
AUDIO_TRACKS_DIRECTORY := $(OUT)/tracks
IMAGE_1ST_READ_BIN     := 0.BIN

IP_VERSION           := V0.100
IP_RELEASE_DATE      := 20260924
IP_AREAS             := JTUBKAEL
IP_PERIPHERALS       := JAMKST
IP_TITLE             := SABER RIDER
IP_MASTER_STACK_ADDR := 0x06004000
IP_SLAVE_STACK_ADDR  := 0x06001E00
IP_1ST_READ_ADDR     := 0x06004000
IP_1ST_READ_SIZE     := 0

include $(YAUL_INSTALL_ROOT)/share/build.post.iso-cue.mk

# no soft-float in the program: libgcc's float / double routines (__addsf3, __muldf3, __fixsfsi, __floatsisf, __ltsf2,
# __extendsfdf2...) in the linked symbols fail the build, with the objects that call them
$(SH_BUILD_PATH)/$(SH_PROGRAM).bin: $(SH_BUILD_PATH)/$(SH_PROGRAM).nofloat
$(SH_BUILD_PATH)/$(SH_PROGRAM).nofloat: $(SH_BUILD_PATH)/$(SH_PROGRAM).elf
	@SF='_*__[a-z]+(sf|df)[23]$$|_*__fix(uns)?(sf|df)(si|di)$$|_*__float(un)?(si|di)(sf|df)$$'; \
	if $(SH_NM) $< | grep -Eq " ($$SF)"; then \
		echo "soft-float linked in:"; $(SH_NM) $< | grep -E " ($$SF)"; \
		for o in $(SH_OBJS_UNIQ); do $(SH_NM) -u $$o | grep -Eq "($$SF)" && echo "  called from $$o"; done; \
		exit 1; \
	fi; touch $@

# the image also follows the staged files (build_disc.py), not only the program; the CUE (which libyaul makes only
# once) follows the image and the CD-DA tracks
$(SH_OUTPUT_PATH)/$(SH_PROGRAM).iso: $(filter-out %/0.BIN,$(wildcard $(IMAGE_DIRECTORY)/*))
ifeq ($(DIAG),1)
$(SH_OUTPUT_PATH)/$(SH_PROGRAM).iso: | diag-stage
.PHONY: diag-stage
diag-stage:
	@[ -f build/saturn/stage/SND.PCK ] || { echo "no build/saturn/stage: make -f Makefile.saturn disc first"; exit 1; }
	mkdir -p $(OUT)/stage
	for f in build/saturn/stage/*; do [ "$${f##*/}" = 0.BIN ] || cp -lf "$$f" $(OUT)/stage/; done
	rm -f $(OUT)/tracks; mkdir -p $(OUT)/tracks
	cp -lf build/saturn/tracks/* $(OUT)/tracks/
endif
$(SH_OUTPUT_PATH)/$(SH_PROGRAM).cue: $(SH_OUTPUT_PATH)/$(SH_PROGRAM).iso $(wildcard $(AUDIO_TRACKS_DIRECTORY)/*)

# the disc as one bin + cue, after every build: libyaul's cue (the .iso as MODE1/2048 + one file per CD-DA track) is
# rewritten in place, so the bin is touched last and stays newer than it
.build: $(SH_OUTPUT_PATH)/$(SH_PROGRAM).bin
$(SH_OUTPUT_PATH)/$(SH_PROGRAM).bin: $(SH_OUTPUT_PATH)/$(SH_PROGRAM).cue tools/saturn/make_bincue.py tools/saturn/iso2352.c
	python3 tools/saturn/make_bincue.py $(OUT)
	touch $@

.PHONY: disc
disc:
	python3 tools/saturn/build_disc.py --data $(DATA) --out $(OUT)
	$(MAKE) -f Makefile.saturn RENDER=$(RENDER)

# the adp68k sound driver (celeriyacon's scspadpcm in third_party/scspadpcm: 68000 code + the SCSP DSP program that
# decodes the ADPCM, 8 KB) goes into the program as src/platform/saturn/adp68k_bin.h, which is committed; this rebuilds
# it (needs a 68000 gcc: M68K_PREFIX)
M68K_PREFIX ?= /opt/saturn/m68k-unknown-elf/bin/m68k-unknown-elf-
ADP_DIR     := $(SH_BUILD_DIR)/adp68k
.PHONY: adp68k
adp68k:
	mkdir -p $(ADP_DIR)
	c++ -std=gnu++11 -O2 -fwrapv -o $(ADP_DIR)/gen-data third_party/scspadpcm/gen-data.cpp
	$(ADP_DIR)/gen-data > $(ADP_DIR)/adp68k-data.h
	$(M68K_PREFIX)gcc -Os -std=gnu99 -march=68000 -fwrapv -fsigned-char -fno-strict-aliasing -Wall -Werror -Wstack-usage=64 \
		-I$(ADP_DIR) -Ithird_party/scspadpcm -nostdlib -Xlinker -Tthird_party/scspadpcm/adp68k.ld \
		-o $(ADP_DIR)/adp68k.elf third_party/scspadpcm/adp68k.c
	$(M68K_PREFIX)objcopy -O binary $(ADP_DIR)/adp68k.elf $(ADP_DIR)/adp68k.bin
	python3 -c "import sys; b = open(sys.argv[1], 'rb').read(); assert len(b) == 8192; \
		print('/* third_party/scspadpcm/adp68k.c built by make -f Makefile.saturn adp68k: sound RAM 0x0000-0x1FFF */'); \
		print('static const uint8_t adp68k_bin[8192] __attribute__((aligned(4))) = {'); \
		[print('    ' + ''.join('0x%02X,' % v for v in b[i:i + 16])) for i in range(0, len(b), 16)]; print('};')" \
		$(ADP_DIR)/adp68k.bin > src/platform/saturn/adp68k_bin.h
