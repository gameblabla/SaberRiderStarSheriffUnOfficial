+    vdp2_sync();                                                               \
+    vdp2_sync_wait();                                                          \
+  }
+
+#define logError(__FMT__, ...)                                                                     \
+  do {                                                                                             \
+    clearLog();                                                                                    \
+    dbgio_printf(__FMT__, __VA_ARGS__);                                                            \
+    dbgio_flush();                                                                                 \
+    vdp2_sync();                                                                                   \
+    vdp2_sync_wait();                                                                              \
+  } while (true)
+
+#define logMessage(__FMT__, ...)                                                                   \
+  do {                                                                                             \
+    dbgio_printf(__FMT__, __VA_ARGS__);                                                            \
+    dbgio_flush();                                                                                 \
+  } while (false)
+
+#else // HAS_DEBUG_REQUIRE_FUNCTIONS
