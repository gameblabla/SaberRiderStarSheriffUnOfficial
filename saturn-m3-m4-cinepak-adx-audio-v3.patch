+#define SMPC_REG_IREG(i) *((volatile unsigned char *) 0x20100001 + ((i) *2))
+#define SMPC_REG_COMREG  *((volatile unsigned char *) 0x2010001F)
+#define SMPC_REG_OREG(o) *((volatile unsigned char *) 0x20100021 + ((o) *2))
