+   mps[0x8] |= DSP_BSEL(1) | DSP_XSEL(0) | DSP_TRA(0x61) | DSP_YSEL(0x1) | DSP_CRA(0x1A);
+   mps[0x9] |= DSP_SHFT0 | DSP_TWT | DSP_TWA(0x60);
+  }
