+   // Saw operator 3
+   //
+   mps[0x6] |= DSP_ZERO | DSP_XSEL(0) | DSP_TRA(0x58) | DSP_YSEL(0x1) | DSP_CRA(0x1E);
+   mps[0x7] |= DSP_BSEL(1) | DSP_XSEL(0) | DSP_TRA(0x5D) | DSP_YSEL(0x1) | DSP_CRA(0x17);
