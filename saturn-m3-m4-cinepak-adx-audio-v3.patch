+    ticks, n = _be32(data, 56), _be32(data, 60)
+    frames: list[tuple[bytes, int, int]] = []
+    for i in range(n):
+        off, length, time, duration = struct.unpack_from('>IIII', data, 64 + i * 16)
+        if time == 0xFFFFFFFF:
