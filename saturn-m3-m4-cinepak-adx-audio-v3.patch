+   mps[0xA] |= DSP_SHFT1 | DSP_TWT | DSP_TWA(0x54);
+  }
+  else if(ads == 4)
+  {
+   //
+   // Saw operator 2
+   //
+   mps[0x2] |= DSP_ZERO | DSP_XSEL(0) | DSP_TRA(0x54) | DSP_YSEL(0x1) | DSP_CRA(0x1D);
